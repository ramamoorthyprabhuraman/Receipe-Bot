    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const raw = String(item.json.text || '')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n\n  const recipeContent = raw\n    .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')\n    .replace(/^\\s*[-•]\\s*/gm, '• ');\n\n  const message = [\n    '👋 Hello there!',\n    '',\n    recipeContent || \"Sorry, I couldn't prepare this recipe. Please try another name.\",\n    '',\n    '👨‍🍳 *Happy cooking!*'\n  ].join('\\n');\n\n  return { json: { text: message } };\n});"
      },
